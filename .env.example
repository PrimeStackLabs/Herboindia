# Herbo India - Production Environment Configuration Template
# Copy this file to .env and fill in your values for live hosting (Render, Railway, Heroku, AWS, VPS).

# Server Configuration
PORT=3000
NODE_ENV=production

# Client / Frontend URL(s) for CORS (Comma-separated for multiple domains, or * for all)
CLIENT_URL=http://localhost:5173,https://your-frontend-domain.vercel.app

# MongoDB Database Connection URI (MongoDB Atlas or Local MongoDB)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/herbo_india?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/herbo_india
DB_NAME=herbo_india

# Master Admin Account (Only master admin can add sub-admins and authorize OTPs)
ADMIN_EMAIL=herboindia03@gmail.com
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=HerboIndia@2026!
ADMIN_DOCTOR_NAME=Chief Medical Administrator (Master Admin)

# SMTP Email Configuration (For Sending Dynamic 6-Digit Verification OTPs)
# To send real emails via Gmail, create an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=herboindia03@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Herbo India Medical Portal <herboindia03@gmail.com>"
